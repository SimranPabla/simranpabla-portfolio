---
import BaseLayout from '../layouts/BaseLayout.astro';
import { links, projects } from '../content/site';
const [integrity, arc, cyberflow, packet, videogen] = projects;
---

<BaseLayout>
  <section class="home-hero shell" id="home" aria-labelledby="hero-title">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="eyebrow">Hello, I’m</p>
      <h1 id="hero-title">Simranjit <span>Singh Pabla</span></h1>
      <p class="hero-role">Software Engineering · AI Systems · Cybersecurity</p>
      <p class="hero-summary">Computing Science student and founder working across AI infrastructure, security automation, and backend systems.</p>
      <div class="actions"><a class="button primary" href="#projects">View my work</a><a class="text-link" href={links.linkedin}>LinkedIn ↗</a><a class="text-link" href={links.github}>GitHub ↗</a><a class="text-link" href={links.resume} download>Resume ↓</a><a class="text-link" href={links.email}>Email ↗</a></div>
    </div>
  </section>

  <section class="section shell" id="experience">
    <p class="eyebrow">Career</p><h2 class="section-title">Experience</h2><p class="section-intro">Founder experience, open-source contributions, and production systems.</p>
    <div class="timeline">
      <article class="timeline-item"><div class="timeline-meta"><span>2023 — Present</span><span>Edmonton, Canada</span></div><h3>Founder &amp; Software Developer</h3><p class="timeline-role">CyberFlow Sentinel</p><ul><li>Built a cybersecurity automation platform that processes 50+ articles per day across n8n, Docker, Airtable, OpenAI, media, and social APIs.</li><li>Automated ingestion through publishing, reducing manual processing by approximately 90%.</li><li>Deployed and debugged Linux/Docker infrastructure supporting content seen by approximately 10,000 weekly viewers.</li></ul></article>
      <article class="timeline-item openclaw-item"><div class="timeline-meta"><span>Open source</span><span>Merged upstream</span></div><h3>Independent Engineering &amp; Open Source</h3><p class="timeline-role">OpenClaw — Open-Source Contributor</p><ul><li>Merged an upstream TypeScript/Linux fix for gateway restart behavior involving inherited cross-user D-Bus state.</li><li>Added regression coverage and validated 36 focused tests.</li></ul><a class="text-link" href={links.openclawPr}>View merged PR #111534 ↗</a></article>
    </div>
  </section>

  <section class="section shell" id="projects">
    <p class="eyebrow">Selected work</p><h2 class="section-title">Projects</h2><p class="section-intro">Five projects across AI controls, automation, networking, and media processing.</p>
    <div class="featured-projects">
      {[integrity, arc].map((project, index) => <a class:list={['feature-card', { arc: index === 0 }]} href={`/work/${project.slug}`}><span class="project-number">0{index + 1} / Featured</span><div><h3>{project.name}</h3><p>{project.summary}</p><ul class="tags" aria-label={`${project.name} technologies`}>{project.stack.slice(0,4).map(item => <li>{item}</li>)}</ul></div></a>)}
    </div>
    <div class="secondary-projects">
      {[cyberflow, packet, videogen].map(project => <a class="mini-project" href={`/work/${project.slug}`}><span><h3>{project.name}</h3><p>{project.summary}</p></span><b aria-hidden="true">↗</b></a>)}
    </div>
  </section>

  <section class="section shell about-grid" id="about">
    <figure class="identity-art"><img src="/simranjit-pabla.webp" alt="Simranjit Singh Pabla at a mountain overlook at sunset" width="1080" height="1440" loading="lazy" decoding="async" /><figcaption>Edmonton, Canada</figcaption></figure>
    <div class="about-copy"><p class="eyebrow">About me</p><h2 class="section-title">I care about what happens when software fails.</h2><p>I’m a University of Alberta Computing Science student and founder based in Edmonton. I work across AI reliability, security, infrastructure, and automation.</p><p>My networking and cybersecurity background shapes how I build: make state visible, handle failure deliberately, and keep important decisions under human control.</p><a class="button primary" href="#contact">Let’s connect</a></div>
  </section>

  <section class="section shell" id="skills">
    <p class="eyebrow">Toolkit</p><h2 class="section-title">Skills</h2><p class="section-intro">Languages, platforms, and tools used in my projects and production work.</p>
    <div class="skill-grid"><article><div><h3>Languages</h3><span>07</span></div><p>Python · TypeScript · JavaScript · SQL · Bash · HTML · CSS</p></article><article><div><h3>Backend &amp; Automation</h3><span>06</span></div><p>Flask · REST APIs · OpenAI API · n8n · Airtable · workflow automation</p></article><article><div><h3>Systems &amp; DevOps</h3><span>08</span></div><p>Linux · Docker · Git · GitHub · GitLab · DigitalOcean · Apache · TLS/SSL</p></article><article><div><h3>Security &amp; Networking</h3><span>08</span></div><p>Active Directory · DNS · DHCP · TCP/IP · routing · VPNs · firewalls · Scapy</p></article></div>
  </section>

  <section class="section shell contact-section" id="contact">
    <p class="eyebrow">Contact</p><h2 class="section-title">Get in touch.</h2>
    <div class="contact-grid"><div class="contact-cards"><a href={links.linkedin}><small>LinkedIn</small><span>Simranjit Singh Pabla ↗</span></a><a href={links.github}><small>GitHub</small><span>@SimranPabla ↗</span></a><a href={links.resume} download><small>Resume</small><span>Download PDF ↓</span></a><a href={links.email}><small>Email</small><span>singhsimranjit9192@gmail.com ↗</span></a></div><form class="contact-form" action="mailto:singhsimranjit9192@gmail.com" method="post" enctype="text/plain"><label>Name<input name="name" autocomplete="name" required /></label><label>Email<input type="email" name="email" autocomplete="email" required /></label><label>Message<textarea name="message" rows="5" required></textarea></label><button class="button primary" type="submit">Send message</button><p>Your email app will open to send the message.</p></form></div>
  </section>
</BaseLayout>
